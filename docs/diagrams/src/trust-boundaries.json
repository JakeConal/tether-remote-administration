  "cards": [
    {
      "dot": "emerald",
      "title": "What Never Crosses",
      "items": [
        "The pre-shared token stays on both sides of the boundary",
        "The console authenticates the agent with an HMAC challenge",
        "The agent does not authenticate the console: it trusts what it dialled"
      ]
    },
    {
      "dot": "rose",
      "title": "What Does Cross, In Clear",
      "items": [
        "Command traffic and results travel as plaintext TCP",
        "Screenshots and keylog captures are visible to anything on the path",
        "Use a trusted segment or a tunnel if the network is not trusted"
      ]
    },
    {
      "dot": "cyan",
      "title": "Operator-Side Storage",
      "items": [
        "The token store and the Gmail credentials live outside the repository",
        "The audit trail is append-only by convention, not by enforcement",
        "Protect the token store with filesystem permissions"
      ]
    }
  ]
