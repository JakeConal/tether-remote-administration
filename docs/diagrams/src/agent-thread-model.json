  "cards": [
    {
      "dot": "cyan",
      "title": "No Pool, No Queue",
      "items": [
        "The agent's own main thread connects, handshakes, pumps, and dispatches",
        "There is no thread pool and no work queue in the agent",
        "The pump cadence is 10 ms"
      ]
    },
    {
      "dot": "emerald",
      "title": "Redial Behaviour",
      "items": [
        "The backoff resets to 500 ms on every successful connect",
        "The agent never exits because the console is absent",
        "The dispatcher outlives every link, so a redial is safe"
      ]
    },
    {
      "dot": "rose",
      "title": "Where Threads Live",
      "items": [
        "Background jobs add one thread each, in the syscall layer",
        "The Windows keyboard hook is dispatched by its owning job thread",
        "The console has no thread of its own either: its transport is pump-driven"
      ]
    }
  ]
