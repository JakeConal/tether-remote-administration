  "cards": [
    {
      "dot": "cyan",
      "title": "Console Side",
      "items": [
        "Unknown verb fails with exit 2 before any config is read",
        "Unknown agent fails with exit 3 before any dispatch",
        "An unconfirmed destructive command fails with exit 4 and nothing is sent"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agent Side",
      "items": [
        "Four refusals run in order - closed set, matrix row, family wired, confirm token - then the family executes",
        "A refusal returns a structured code and the session stays usable",
        "Arguments reach the family as literal argv data"
      ]
    },
    {
      "dot": "rose",
      "title": "Result Shapes",
      "items": [
        "Text results ride one RESULT_TEXT frame",
        "File results ride FILE_META, FILE_CHUNK and FILE_END",
        "An empty listing rides the file channel, because empty text is rejected at decode"
      ]
    }
  ]
