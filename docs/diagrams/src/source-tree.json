  "cards": [
    {
      "dot": "cyan",
      "title": "Reading Order",
      "items": [
        "lib/protocol owns the wire and knows nothing about the command set",
        "lib/syscalls owns the command set and knows nothing about the wire",
        "console and agent are thin: they wire the layers together"
      ]
    },
    {
      "dot": "emerald",
      "title": "Test Layout",
      "items": [
        "One doctest translation unit per area, so a failing assert pins one suite",
        "Suites use in-memory pipes or loopback sockets, and exercise the real disk, child-process, and display paths where they can",
        "The end-to-end suite is split into eleven per-case ctest partitions"
      ]
    }
  ]
