  "cards": [
    {
      "dot": "rose",
      "title": "Two Gates, Different Verb Sets",
      "items": [
        "Gate A covers delete, shutdown and restart",
        "Gate B covers all five destructive verbs: delete, move, copy, shutdown, restart",
        "move and copy skip Gate A, so the console dispatches them and the agent refuses them"
      ]
    },
    {
      "dot": "emerald",
      "title": "What a Refusal Means",
      "items": [
        "Gate A refusal: nothing is sent, exit code 4",
        "Gate B refusal: nothing is executed, exit code 1",
        "The console never injects the confirm token for you"
      ]
    },
    {
      "dot": "cyan",
      "title": "Where Each Gate Lives",
      "items": [
        "Gate A is the console-side kDestructiveCommands list",
        "Gate B is the destructive flag on the capability matrix row",
        "The unknown-agent check precedes both gates"
      ]
    }
  ]
