  "cards": [
    {
      "dot": "cyan",
      "title": "Layer Rules",
      "items": [
        "Dependencies flow one way: a layer never reaches back up",
        "The protocol layer never sees a socket, an OS API, or the command set",
        "The syscall layer never sees the wire, the console, or CLI details"
      ]
    },
    {
      "dot": "emerald",
      "title": "Direct Edges Not Drawn",
      "items": [
        "tether-cli also links tether-protocol directly: it speaks Cmd and CommandView",
        "tether-command-handler also links tether-common and tether-protocol",
        "tether-console links tether-common, tether-protocol and tether-transport"
      ]
    },
    {
      "dot": "rose",
      "title": "Third-Party Dependencies",
      "items": [
        "tether-common and tether-protocol use nlohmann-json; tether-protocol uses mbedtls",
        "tether-transport uses asio publicly and cpr privately (Gmail only)",
        "tether-syscalls uses OpenCV and, on Linux, X11 - and no tether library at all"
      ]
    }
  ]
