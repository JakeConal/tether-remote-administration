  "cards": [
    {
      "dot": "cyan",
      "title": "Slot Rules",
      "items": [
        "A duplicate start is refused and the incumbent job is left untouched",
        "A stop with nothing running is refused as not_running",
        "The registry is shared process-wide, so the camera and input families never collide"
      ]
    },
    {
      "dot": "emerald",
      "title": "Threading",
      "items": [
        "The worker owns its capture loop and never takes the session's locks",
        "Deliverables cross threads through the handle's mutex",
        "The session stays responsive because the job lives in the syscall layer"
      ]
    },
    {
      "dot": "rose",
      "title": "Honest Failures",
      "items": [
        "A job that produced nothing fails loudly instead of reporting an empty success",
        "A camera that cannot be opened surfaces as a classified failure at stop time; an unopenable keylogger storage path is refused at start",
        "The keylogger capture is a real zero-byte file when nothing was typed"
      ]
    }
  ]
