  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime Shape",
      "items": [
        "The console is not a daemon: one invocation serves one verb and exits",
        "The agent is the long-running half and dials out forever",
        "Nothing listens on the target, so NAT and firewalls need no inbound port"
      ]
    },
    {
      "dot": "emerald",
      "title": "Safety Controls",
      "items": [
        "Every session authenticates with an HMAC challenge before any command traffic",
        "Arguments travel as argv data and are never re-joined into a shell line",
        "Destructive verbs need a confirmation token at the agent"
      ]
    },
    {
      "dot": "rose",
      "title": "Command Surface",
      "items": [
        "The closed set is 19 verbs over 7 families, matched exactly",
        "An unsupported combination returns a structured refusal and the session stays usable",
        "Every exec attempt is recorded when the console has an audit path configured"
      ]
    }
  ]
