  "cards": [
    {
      "dot": "cyan",
      "title": "Loading Rules",
      "items": [
        "Every problem is an explicit failure naming the file and the field",
        "The loaders never substitute silent defaults for a malformed file",
        "A missing console config falls back to localhost, an ephemeral port, and no token store"
      ]
    },
    {
      "dot": "rose",
      "title": "Where the Secrets Live",
      "items": [
        "The token store holds the pre-shared token per agent identity",
        "The Gmail credentials file holds the OAuth refresh token",
        "Both live at operator-chosen paths outside the repository; protect them with file permissions"
      ]
    },
    {
      "dot": "emerald",
      "title": "The Shared Secret",
      "items": [
        "The agent's token and the console's token store must agree exactly",
        "The identity in the store must match agent_name exactly",
        "The shipped console parses the gmail section but does not yet construct the adapter"
      ]
    }
  ]
