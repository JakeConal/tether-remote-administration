{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "tether",
  "version-string": "0.1.0",
  "dependencies": [
    "mbedtls",
    "doctest",
    "nlohmann-json",
    "asio",
    "cpr",
    "cli11",
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "png",
        { "name": "jpeg", "platform": "windows" },
        { "name": "v4l", "platform": "linux" },
        { "name": "dshow", "platform": "windows" },
        { "name": "msmf", "platform": "windows" }
      ]
    }
  ]
}
